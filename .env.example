.env.example# =============================================================================
# 环境变量示例文件
# -----------------------------------------------------------------------------
# 用法：把本文件复制一份改名为 .env，然后填入你自己的配置：
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (macOS / Linux)
#
# 【重要】什么都不填也能学完整个项目！
#   当没有配置任何 API Key 时，项目会自动切换到「离线模拟模型」(见 common/fake_model.py)，
#   它用规则模拟了大模型的"回复 + 工具调用"行为，所有课程都能跑通、能看结果。
#   等你理解了原理，再填下面任意一个 Key 换成真正的大模型即可。
# =============================================================================

# -----------------------------------------------------------------------------
# 方式一（推荐国内用户）：任何「OpenAI 兼容」的服务，只要改基址和模型名
# -----------------------------------------------------------------------------
# 大模型服务商。可选值：openai / anthropic / deepseek / ollama / custom
LLM_PROVIDER=custom

# 你的 API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 接口基址（/v1 结尾）。下面是几种常见服务商的写法，按需取消注释：
#   DeepSeek    : https://api.deepseek.com/v1
#   Moonshot    : https://api.moonshot.cn/v1
#   阿里通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM    : https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama : http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# 方式二：使用官方 SDK 的默认配置（LLM_PROVIDER 改成 openai / anthropic）
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# -----------------------------------------------------------------------------
# 可选：LangSmith 追踪（能可视化看到每一步节点执行，学习时非常有用）
# 注册地址：https://smith.langchain.com
# -----------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxx
# LANGCHAIN_PROJECT=learn-langgraph
